{
  "name": "parse-css-rules",
  "version": "1.0.0",
  "description": "CSS tagged template literal that parses CSS syntax into a composable JavaScript object",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build": "npm run build:esm && npm run build:cjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "css-in-js",
    "tagged-template",
    "css-template",
    "stylesheet",
    "css-object"
  ],
  "author": "nicholasbg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicholasbg/parseCSSRules.git"
  },
  "peerDependencies": {
    "csstype": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "csstype": {
      "optional": true
    }
  },
  "devDependencies": {
    "add-css-rules": "^1.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
